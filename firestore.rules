rules_version = '2';

// Catatan: daftar admin di bawah harus sinkron dengan NEXT_PUBLIC_ADMIN_EMAILS di .env.local.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['admin@galamerch.com', 'admin@example.com'];
    }

    function isOwnerOrAdmin(userId, userEmail) {
      return isAdmin() || (request.auth != null && (request.auth.uid == userId || request.auth.token.email == userEmail));
    }

    match /products/{productId} {
      allow read: if true;
      // Hanya akun admin (login Firebase Auth) yang boleh mengubah katalog.
      allow create, update, delete: if isAdmin();
    }

    match /alumniTicketBundles/{bundleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery/{itemId} {
      // Galeri dokumentasi publik dibaca siapa pun; pengelolaan hanya oleh admin.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /alumniTickets/{ticketId} {
      // Admin dapat membaca semua tiket, user hanya tiket miliknya
      allow read: if isAdmin() || (request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.email == resource.data.userEmail));
      // Pembeli login/tamu membuat tiket saat checkout, admin dapat mengubah
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Pembeli login membuat pesanan atas namanya sendiri;
      // guest (belum login) hanya boleh membuat pesanan dengan userId berawalan "guest-".
      allow create: if isAdmin()
        || (request.auth != null && request.resource.data.userId == request.auth.uid)
        || (request.auth == null && request.resource.data.userId is string && request.resource.data.userId.matches('^guest-.*'));

      // User hanya dapat membaca pesanannya sendiri; admin dapat membaca semua.
      allow read: if isAdmin()
        || (request.auth != null
            && (resource.data.userId == request.auth.uid
                || resource.data.userEmail == request.auth.token.email));

      // Perubahan status pesanan & penghapusan hanya oleh admin.
      allow update, delete: if isAdmin();
    }

    // Tolak semua koleksi lain secara default (tidak menulis aturan = ditolak).
  }
}
